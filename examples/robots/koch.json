{
  "robotConfig": {
    "type": "koch_follower",
    "id": "koch_follower",
    "port": "/dev/ttyACM0",
    "use_degrees": true,
    "cameras": {}
  },
  "registrationModules": ["lerobot.robots.koch_follower"],
  "controlHz": 30,
  "units": {
    "shoulder_pan.pos": "degrees",
    "shoulder_lift.pos": "degrees",
    "elbow_flex.pos": "degrees",
    "wrist_flex.pos": "degrees",
    "wrist_roll.pos": "degrees",
    "gripper.pos": "normalized 0 to 100"
  }
}
